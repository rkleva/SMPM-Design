    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"<h1> STATOR WINDING INDUCTANCES </h1>\",\n",
    "   \"id\": \"a0474d54671cbfba\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"<h2> Magnetizing inductance </h2>\",\n",
    "   \"id\": \"e31725d07c823ddf\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-04T13:24:05.777007Z\",\n",
    "     \"start_time\": \"2026-02-04T13:24:05.767881Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"L_m = m * 2/(p * math.pi**2) * (w * f_w / a)**2 * tau_p * l * mi_0 / delta_double_marked\\n\",\n",
    "    \"display(Latex(rf'$L_{{m}} = {L_m: .2e} \\\\, H$'))\\n\"\n",
    "   ],\n",
    "   \"id\": \"6cfc358e97ada029\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<IPython.core.display.Latex object>\"\n",
    "      ],\n",
    "      \"text/latex\": \"$L_{m} =  1.91e-06 \\\\, H$\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 154\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"<h2> Leakage inductance\",\n",
    "   \"id\": \"c1cb89b9a0a3ae32\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-04T13:27:47.869970Z\",\n",
    "     \"start_time\": \"2026-02-04T13:27:47.844005Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"k_sl = 3 * y / (m*q) - 1\\n\",\n",
    "    \"display(Latex(rf'$k_{{sl}} = {round(k_sl, 2)}$'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"t1 = b2/bs\\n\",\n",
    "    \"t2 = b1/b2\\n\",\n",
    "    \"t12 = t2\\n\",\n",
    "    \"\\n\",\n",
    "    \"k_t_1 = (4*t1**2 - t1**4 - 4 * math.log(t1) - 3 ) / (4 * (1 - t1) * (1 - t1**2)**2 )\\n\",\n",
    "    \"k_t_2 = (4*t2**2 - t2**4 - 4 * math.log(t2) - 3 ) / (4 * (1 - t2) * (1 - t2**2)**2 )\\n\",\n",
    "    \"k_t_12 = (t12**2 - 2 * math.log(t2) - 1) / (2 * (1 - t12) * (1 - t12**2) )\\n\",\n",
    "    \"\\n\",\n",
    "    \"lambda_b = h3 * k_t_1 / bs + h2 / (b2 - b1) * math.log(b2/b1) + 0.1424 + 0.5 * math.asin(math.sqrt( 1 - (bo / b1 )**2 )) + ho / bo\\n\",\n",
    "    \"lambda_t = h2 * k_t_2 / b2 + 0.1424 + 0.5 * math.asin(math.sqrt(1 - (bo / b1)**2 )) + ho / bo\\n\",\n",
    "    \"lambda_tb = h2 * k_t_12 / b2 + 0.1424 + 0.5 * math.asin(math.sqrt( 1 - (bo / b1 )**2 ) ) + ho / bo\\n\",\n",
    "    \"# Slot leakage\\n\",\n",
    "    \"L_sigma_sl = mi_0 * 2 * l/ (4 * p * q)  * (w / a)**2 * (lambda_t + lambda_b + k_sl * lambda_tb)\\n\",\n",
    "    \"display(Latex(rf'$L_{{\\\\sigma sl}} = {L_sigma_sl: .2e}\\\\, H$'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"lambda_tt = (0.25 + 0.75 * y / tau_p) * (5 * delta_triple_marked / bo) / ( 5 + 4 * delta_triple_marked / bo )\\n\",\n",
    "    \"# Tooth tip leakage\\n\",\n",
    "    \"L_sigma_tt = mi_0 * 2 / (p * q) * l * (w / a)**2 * lambda_tt\\n\",\n",
    "    \"display(Latex(rf'$L_{{\\\\sigma tt}} = {L_sigma_tt : .2e} \\\\, H$'))\\n\",\n",
    "    \"# Harmonic leakage\\n\",\n",
    "    \"# It is required to generate the array of harmonics that will be used\\n\",\n",
    "    \"ni = np.array([5,7,11,13,17,19])\\n\",\n",
    "    \"sum_fw_ni = 0\\n\",\n",
    "    \"# --------------------------------------\\n\",\n",
    "    \"for v in ni:\\n\",\n",
    "    \"    f_d_ni = math.sin(math.radians(q_dash*v*alfa_dash/2)) / (q_dash*math.sin(math.radians(v*alfa_dash/2)))\\n\",\n",
    "    \"    f_p_ni = math.sin(v**math.pi*y/(tau_p*2))\\n\",\n",
    "    \"    f_w_ni = f_p_ni*f_d_ni\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sum_fw_ni += (f_w_ni / v)**2\\n\",\n",
    "    \"\\n\",\n",
    "    \"sigma_v = sum_fw_ni / f_w**2\\n\",\n",
    "    \"L_sigma_v = L_m * sigma_v\\n\",\n",
    "    \"display(Latex(rf'$L_{{\\\\sigma v}} = {L_sigma_v:.2e}\\\\, H$'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# End winding leakage\\n\",\n",
    "    \"l_ew = 0.0618\\n\",\n",
    "    \"lambda_ew = 0.34 * q * (1 - 2*y*tau_p /(math.pi * m * q * l_ew) )\\n\",\n",
    "    \"L_sigma_ew = mi_0 * 2 / (p * q) * (150 / a)**2 * l_ew * lambda_ew\\n\",\n",
    "    \"display(Latex(rf'$L_{{\\\\sigma ew}} = {L_sigma_ew: .2e} \\\\, H$'))\\n\",\n",
    "    \"#Total leakage inductance\\n\",\n",
    "    \"L_sigma = L_sigma_sl + L_sigma_tt + L_sigma_v + L_sigma_ew\\n\",\n",
    "    \"display(Latex(rf'$L_{{\\\\sigma}} = {L_sigma: .2e} \\\\, H$'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"#Total leakage reactance\\n\",\n",
    "    \"X_sigma = L_sigma * 2 * math.pi * f\\n\",\n",
    "    \"display(Latex(rf'$X_{{\\\\sigma}} = {X_sigma: .2e} \\\\, {{\\\\ohm}}$'))\"\n",
    "   ],\n",
