    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"b_t_I = tau_s - b_o\\n\",\n",
    "    \"b_t_II_0 = tau_s - b_o\\n\",\n",
    "    \"b_t_II_half = (b_t_I + b_t) / 2\\n\",\n",
    "    \"b_t_II_h_1 = b_t\\n\",\n",
    "    \"b_t_III = b_t\\n\",\n",
