    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Core losses\",\n",
    "   \"id\": \"10339dfbb9b00370\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-30T16:06:49.505799Z\",\n",
    "     \"start_time\": \"2026-01-30T16:06:49.473501Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"B_t_I_v = Any\\n\",\n",
    "    \"B_t_II_v_0 = Any\\n\",\n",
    "    \"B_t_II_v_half = Any\\n\",\n",
    "    \"B_t_II_v_h_1 = Any\\n\",\n",
    "    \"B_t_III_v = Any\\n\",\n",
    "    \"Psi_t_v = Any\\n\",\n",
    "    \"B_delta_m_v = Any\\n\",\n",
    "    \"Pc_new = 500\\n\",\n",
    "    \"Pc_old = 10\\n\",\n",
    "    \"Pct_I = 0\\n\",\n",
    "    \"Pct_II = 0\\n\",\n",
    "    \"Pct_III = 0\\n\",\n",
    "    \"P_cys = 0\\n\",\n",
    "    \"P_total = 0\\n\",\n",
    "    \"# v_B_t_I = 0\\n\",\n",
    "    \"# v_B_t_II_0 = 0\\n\",\n",
    "    \"# v_B_t_II_half = 0\\n\",\n",
    "    \"# v_B_t_II_h_1 = 0\\n\",\n",
    "    \"# v_B_t_III = 0\\n\",\n",
    "    \"# v_B_ysv = 0\\n\",\n",
    "    \"f = 50\\n\",\n",
    "    \"\\n\",\n",
    "    \"iter = 1\\n\",\n",
    "    \"v = 1\\n\",\n",
    "    \"n = 2\\n\",\n",
    "    \"while (abs(Pc_old - Pc_new)/Pc_old) > 0.01:\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Pc_old = Pc_new\\n\",\n",
    "    \"    Pc_new = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_delta_m_v = (4/math.pi) * (1/v) * B_delta_m * abs(math.sin(v * (alpha_m * math.pi / 180)/2  ))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Psi_t_v = l * (D/2) * B_delta_m_v * ( 2 / (v*p) ) * abs(math.sin( v * p * math.pi / Q_s ))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Psi_ys_v = l * (D/2) * B_delta_m_v * (1/ (v * p) )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_t_I_v = Psi_t_v / (k_fe * b_t_I * l)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_t_II_v_0 = Psi_t_v / (k_fe * b_t_II_0 * l)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_t_II_v_half = Psi_t_v / (k_fe * b_t_II_half * l)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_t_II_v_h_1 = Psi_t_v / (k_fe * b_t_II_h_1 * l)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_t_III_v = Psi_t_v / (k_fe * b_t_III * l)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    B_ysv = Psi_ys_v / (k_fe * h_ys * l)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Pct_I = Kx_Fe*Q_s * (k_h * f * B_t_I**(a_h + b_h*B_t_I) + k_e * f**2 * (v * B_t_I_v)**2) * ro_c * k_fe * b_t_I * h_o * l\\n\",\n",
    "    \"    Pc_new += Pct_I\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Pct_II = Kx_Fe * Q_s * ro_c * k_fe * l * (h1 / 6) * ( (k_h * f * B_t_II_0 **(a_h + b_h*B_t_II_0) + k_e * f**2 * (v * B_t_II_v_0)**2 ) * b_t_II_0 + \\\\\\n\",\n",
    "    \"    4 * (k_h * f * B_t_II_half**(a_h + b_h*B_t_II_half) + k_e * f**2 * (v * B_t_II_v_half)**2 ) * b_t_II_half + \\\\\\n\",\n",
    "    \"    (k_h * f * B_t_II_h_1**(a_h + b_h*B_t_II_h_1) + k_e * f**2 * (v * B_t_II_v_h_1)**2 ) * b_t_II_h_1                                                      )\\n\",\n",
    "    \"    Pc_new += Pct_II\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Pct_III = Kx_Fe * Q_s * (k_h * f * B_t_III**(a_h + b_h*B_t_III) + k_e * f**2 * (v * B_t_III_v)**2) * ro_c * k_fe * b_t_III * (h2 + h3) * l\\n\",\n",
    "    \"    Pc_new += Pct_III\\n\",\n",
    "    \"\\n\",\n",
    "    \"    P_cys = Kx_Fe * (k_h * f * B_ys**(a_h + b_h*B_ys) + k_e * f**2 * (v * B_ysv)**2) * ro_c * k_fe * (Do**2 - (D + 2 * hs)**2 ) * (math.pi / 4) * l\\n\",\n",
    "    \"    Pc_new += P_cys\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    P_total += Pct_I + Pct_II + Pct_III + P_cys\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"In iteration {iter}. the difference was {(abs(Pc_old - Pc_new)/Pc_old) * 100} \\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    iter += 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n += 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    v += 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(P_total)\\n\"\n",
    "   ],\n",
    "   \"id\": \"5aec2adc83723099\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"In iteration 1. the difference was 91.54454455130058 \\n\",\n",
    "      \"In iteration 2. the difference was 13.019930518379166 \\n\",\n",
    "      \"In iteration 3. the difference was 0.7367439063100172 \\n\",\n",
    "      \"116.0938088870703\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 33\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Magnet losses\",\n",
    "   \"id\": \"2d9705e2ca04e743\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-30T16:06:59.414590Z\",\n",
    "     \"start_time\": \"2026-01-30T16:06:59.380594Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"P_m_new = 100\\n\",\n",
    "    \"P_m_old = 10\\n\",\n",
    "    \"P_magnet_total = 0\\n\",\n",
    "    \"sigma_m = 1 / (ro_magnet*1e-6*1e-2)\\n\",\n",
    "    \"v = 1\\n\",\n",
    "    \"N_seg_tan = 5\\n\",\n",
    "    \"N_seg_ax = 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"b_m_seg = 3.25e-3#(alpha_m / N_seg_tan) * (D / (2 * p))\\n\",\n",
    "    \"l_m_seg = 0.014286#l / N_seg_ax\\n\",\n",
    "    \"\\n\",\n",
    "    \"while (abs(P_m_old - P_m_new)/P_m_old) > 0.01 and P_m_new > 0.0001:\\n\",\n",
    "    \"\\n\",\n",
    "    \"    P_m_old = P_m_new\\n\",\n",
    "    \"\\n\",\n",
    "    \"    u = b_o / (2 * delta) + math.sqrt(1 + (b_o / (2 * delta))**2 )\\n\",\n",
    "    \"    beta = (1 + u**2 - 2*u) / (2 * (1 + u**2))\\n\",\n",
    "    \"    bo_marked = ( delta * (b_o/delta)**2 ) / (beta * (5 + (b_o / delta) ) )\\n\",\n",
    "    \"    alpha_1_v = 2 * math.sin( v * math.pi * bo_marked / tau_s ) / (v * math.pi * (1 - (v*bo_marked/tau_s)**2 ) )\\n\",\n",
    "    \"    B_v = B_delta_m * beta * k_c * alpha_1_v\\n\",\n",
    "    \"    tau_v = tau_s / (2 * v)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    f_mv = v*Q_s*n_r/60\\n\",\n",
    "    \"    omega_mv = 2*math.pi*f_mv\\n\",\n",
    "    \"    delta_mv = math.sqrt(2 / (omega_mv* mi_rm * mi_0 * sigma_m))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if v == 1 and N_seg_ax >= l/delta_mv:\\n\",\n",
    "    \"        raise ValueError(\\\"N_seg_ax > l/delta_mv, see script\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if l_m_seg < delta_mv:\\n\",\n",
    "    \"        raise ValueError(\\\"l_m_seg < delta_mv, see script\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if b_m_seg > tau_v:\\n\",\n",
    "    \"        Psi_mv = (2 / math.pi) * B_v * tau_v * l_m_seg\\n\",\n",
    "    \"        E_mv = (1/math.sqrt(2)) * omega_mv * Psi_mv\\n\",\n",
    "    \"\\n\",\n",
    "    \"        S_m_ax_v = (tau_v / 2) * (delta_mv / 2) * (1 - math.exp(-2*h_m / delta_mv))\\n\",\n",
    "    \"        S_m_tan_v = delta_mv * (delta_mv / 2) * (1 - math.exp(-2*h_m / delta_mv))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        R_mv = (math.pi / 2) * ( 2 * (l_m_seg - delta_mv) / S_m_ax_v + 2*tau_v / S_m_tan_v ) * (1/sigma_m)\\n\",\n",
    "    \"        Z_mv = math.sqrt(2)*R_mv\\n\",\n",
    "    \"        I_mv = E_mv / Z_mv\\n\",\n",
    "    \"        P_m_seg_v = E_mv * I_mv * math.cos(phi_v * math.pi/180)\\n\",\n",
    "    \"        P_m_new = 2*p*(b_m_seg / tau_v) * N_seg_tan * N_seg_ax * P_m_seg_v\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        Psi_mv = B_v * b_m_seg * l_m_seg\\n\",\n",
    "    \"        E_mv = (1/math.sqrt(2)) * omega_mv * Psi_mv\\n\",\n",
    "    \"        S_m_ax_v = (b_m_seg/2) * (delta_mv / 2) * (1 - math.exp(-2*h_m / delta_mv))\\n\",\n",
    "    \"        S_m_tan_v = S_m_ax_v\\n\",\n",
    "    \"        R_mv = 2*(l_m_seg/S_m_ax_v + b_m_seg/S_m_tan_v) * (1/sigma_m)\\n\",\n",
    "    \"        Z_mv = math.sqrt(2)*R_mv\\n\",\n",
    "    \"        I_mv = E_mv / Z_mv\\n\",\n",
    "    \"        P_m_seg_v = E_mv * I_mv * math.cos(phi_v * math.pi/180)\\n\",\n",
    "    \"        P_m_new = 2*p*N_seg_tan * N_seg_ax * P_m_seg_v\\n\",\n",
    "    \"\\n\",\n",
    "    \"    P_magnet_total += P_m_new\\n\",\n",
    "    \"    v += 2\\n\",\n",
    "    \"    print(f\\\"In iteration {v}. the difference was {(abs(P_m_old - P_m_new)/P_m_old) * 100} \\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(P_magnet_total)\"\n",
    "   ],\n",
    "   \"id\": \"6eb73b40621b4ac9\",\n",
    "   \"outputs\": [\n",
